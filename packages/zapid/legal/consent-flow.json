{
  "version": "7.2",
  "screens": [
    {
      "id": "TERMS_SCREEN",
      "title": "Terms of Use",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Terms of Use"
          },
          {
            "type": "TextSubheading",
            "text": "1. Acceptance"
          },
          {
            "type": "TextBody",
            "text": "By using AI Assistant by Malbq, you agree to these terms."
          },
          {
            "type": "TextSubheading",
            "text": "2. Service Description"
          },
          {
            "type": "TextBody",
            "text": "AI Assistant by Malbq is a WhatsApp virtual assistant that helps you organize information, answer questions, and handle everyday tasks."
          },
          {
            "type": "TextSubheading",
            "text": "3. Permitted Use"
          },
          {
            "type": "TextBody",
            "text": "• Use the service for personal and lawful purposes\n• Do not share illegal, offensive, or harmful content\n• Do not try to bypass service limits or restrictions"
          },
          {
            "type": "TextSubheading",
            "text": "4. Service Limits"
          },
          {
            "type": "TextBody",
            "text": "• The service has daily usage limits that vary by plan\n• Responses are generated by artificial intelligence and may contain errors\n• We do not guarantee uninterrupted availability"
          },
          {
            "type": "TextSubheading",
            "text": "5. Intellectual Property"
          },
          {
            "type": "TextBody",
            "text": "AI Assistant by Malbq and its technology are the property of its developers. You retain ownership of the content you send."
          },
          {
            "type": "TextSubheading",
            "text": "6. Limitation of Liability"
          },
          {
            "type": "TextBody",
            "text": "The service is provided \"as is\". We are not responsible for decisions made based on the assistant's responses."
          },
          {
            "type": "TextSubheading",
            "text": "7. Changes"
          },
          {
            "type": "TextBody",
            "text": "We may change these terms at any time. Significant changes will be announced by the assistant itself."
          },
          {
            "type": "TextSubheading",
            "text": "8. Contact"
          },
          {
            "type": "TextBody",
            "text": "Questions about these terms? Send the assistant a message asking for support."
          },
          {
            "type": "Footer",
            "label": "Next: Privacy Policy",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "PRIVACY_SCREEN"
              }
            }
          }
        ]
      }
    },
    {
      "id": "PRIVACY_SCREEN",
      "title": "Privacy Policy",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Privacy Policy"
          },
          {
            "type": "TextSubheading",
            "text": "1. Data Collected"
          },
          {
            "type": "TextBody",
            "text": "We collect:\n• Your phone number and WhatsApp name\n• Messages sent to the assistant\n• Shared files (audio, images, documents)"
          },
          {
            "type": "TextSubheading",
            "text": "2. How We Use Your Data"
          },
          {
            "type": "TextBody",
            "text": "Your data is used to:\n• Process your messages and generate responses\n• Keep conversation history for context"
          },
          {
            "type": "TextSubheading",
            "text": "3. Storage"
          },
          {
            "type": "TextBody",
            "text": "• Messages and files are stored on secure servers\n• Data is retained while you use the service\n• You can request deletion of your data at any time"
          },
          {
            "type": "TextSubheading",
            "text": "4. Sharing"
          },
          {
            "type": "TextBody",
            "text": "We do not sell your data. We may share it with:\n• Infrastructure providers (hosting, AI)\n• Authorities, when required by law"
          },
          {
            "type": "TextSubheading",
            "text": "5. Your Rights (LGPD)"
          },
          {
            "type": "TextBody",
            "text": "You have the right to:\n• Access your data\n• Correct inaccurate data\n• Request deletion\n• Revoke consent"
          },
          {
            "type": "TextSubheading",
            "text": "6. Security"
          },
          {
            "type": "TextBody",
            "text": "We use encryption and security practices to protect your data."
          },
          {
            "type": "TextSubheading",
            "text": "7. Contact"
          },
          {
            "type": "TextBody",
            "text": "To exercise your rights or ask questions, send the assistant a message asking for privacy support."
          },
          {
            "type": "Footer",
            "label": "Next: Confirm Consent",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "CONSENT_SCREEN"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CONSENT_SCREEN",
      "title": "Consent",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Confirm Your Consent"
          },
          {
            "type": "TextBody",
            "text": "To continue using AI Assistant by Malbq, please confirm that you have read and agree to the Terms of Use and Privacy Policy."
          },
          {
            "type": "OptIn",
            "name": "terms_accepted",
            "label": "I have read and accept the Terms of Use",
            "required": true
          },
          {
            "type": "OptIn",
            "name": "privacy_accepted",
            "label": "I have read and accept the Privacy Policy",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Accept and Continue",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "terms_accepted": "${form.terms_accepted}",
                "privacy_accepted": "${form.privacy_accepted}",
                "consent_timestamp": "${meta.timestamp}"
              }
            }
          }
        ]
      }
    }
  ]
}
