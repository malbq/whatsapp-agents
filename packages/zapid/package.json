{
  "name": "@wa/agent-zapid",
  "version": "0.0.1",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun run --hot --no-clear-screen index.ts",
    "build": "bun run ./bin/build.ts",
    "start": "bun run ./bin/start.ts",
    "stop": "bun run ./bin/stop.ts",
    "typecheck": "tsc",
    "lint": "oxlint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:clean": "bun run ./bin/db-clean.ts",
    "db:seed": "bun run ./bin/db-seed.ts",
    "knip": "bunx knip"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@wa/core": "workspace:*",
    "@wa/server": "workspace:*",
    "@wa/whatsapp": "workspace:*",
    "@sentry/bun": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
