# Google OAuth (dashboard login + calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=
DASHBOARD_REDIRECT_URI=http://localhost:8080/auth/callback
CALENDAR_REDIRECT_URI=http://localhost:8080/api/calendar/callback

# Optional
PORT=8080
