# WhatsApp Cloud API
META_API_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WA_BUSINESS_PHONE_ID=
WA_API_VERSION=v23.0

# Database (`docker compose up -d` from repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warden

# AI provider
