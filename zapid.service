[Unit]
Description=WhatsApp AI Assistant Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=zapid
Group=zapid
SyslogIdentifier=zapid
WorkingDirectory=/opt/zapid
EnvironmentFile=/opt/zapid/.env
Environment=NODE_ENV=production
ExecStartPre=/usr/local/bin/bun run db:init
ExecStart=/usr/local/bin/bun run src/index.ts
ReadWritePaths=/opt/zapid/storage
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictRealtime=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
LimitNOFILE=16384
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

