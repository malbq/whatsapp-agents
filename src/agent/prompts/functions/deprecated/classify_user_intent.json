{
  "strict": true,
  "type": "function",
  "name": "classify_user_intent",
  "description": "Array of context types needed for the conversation. At least one context is required.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "context": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "memory",
            "schedule",
            "file",
            "web"
          ],
          "minItems": 1
        }
      }
    },
    "required": [
      "context"
    ]
  }
}