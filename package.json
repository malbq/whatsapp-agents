{
  "name": "zapid",
  "version": "0.1.8",
  "type": "module",
  "packageManager": "bun",
  "scripts": {
    "dev": "bun --hot --no-clear-screen run src/index.ts",
    "docker:setup": "./setup-docker-host.sh",
    "docker:logs": "docker compose logs -f",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "typecheck": "tsc",
    "db:migrate": "atlas schema apply --env local --auto-approve",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.23",
    "@ai-sdk/openai": "^2.0.52",
    "@ai-sdk/openai-compatible": "^1.0.22",
    "@ai-sdk/xai": "^2.0.26",
    "@libsql/client": "^0.15.15",
    "@logtape/logtape": "^1.1.1",
    "@logtape/otel": "^1.1.1",
    "ai": "^5.0.71",
    "compromise": "^14.14.4",
    "hono": "^4.9.12",
    "retext": "^9.0.0",
    "retext-readability": "^8.0.0",
    "retext-smartypants": "^6.2.0",
    "unpdf": "^1.3.2",
    "unstorage": "^1.17.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "oxlint": "^1.23.0",
    "typescript": "^5.9.3"
  }
}
