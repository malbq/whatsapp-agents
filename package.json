{
  "name": "zapid",
  "version": "0.4.23",
  "private": true,
  "type": "module",
  "packageManager": "bun",
  "workspaces": [
    "packages/*",
    "packages/agent/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "run:zapid": "bun run --filter '@batman/agent-zapid' dev",
    "run:frm": "bun run --filter '@batman/agent-frm' dev",
    "run:cmd": "bun run --filter '@batman/agent-cmd' dev"
  },
  "catalog": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.10.0",
    "ai": "^6.0.0-beta.94",
    "compromise": "^14.14.4",
    "drizzle-orm": "0.44.7",
    "drizzle-kit": "^0.31.6",
    "hono": "^4.10.1",
    "oxlint": "^1.23.0",
    "postgres": "^3.4.5",
    "retext": "^9.0.0",
    "retext-readability": "^8.0.0",
    "retext-smartypants": "^6.2.0",
    "typescript": "^5.9.3",
    "unpdf": "^1.3.2",
    "unstorage": "^1.17.1",
    "zod": "^4.1.12",
    "@ai-sdk/google": "^3.0.0-beta.39",
    "@ai-sdk/openai": "^3.0.0-beta.54",
    "@ai-sdk/xai": "^3.0.0-beta.35",
    "@ai-sdk/provider-utils": "^4.0.0-beta.33"
  }
